<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Color-theme overlays. Each ThemeOverlay.Launch.Palette.* declares every semantic attr
        from attrs.xml; ui/theme/ThemeManager.kt applies one on top of the base Theme.Launch /
        Theme.Launch.Settings via Activity.theme.applyStyle(..., force = true).

        parent="" is deliberate: these are pure attribute bags, not meant to inherit Material's
        own theme chain (that would pull in unrelated defaults and risk clobbering
        colorPrimary/colorAccent etc. set directly on Theme.Launch).

        Nord is included even though it duplicates Theme.Launch's own base values, so every
        palette (selected or not) goes through the exact same application path — no special
        "no overlay needed for the default" branch in ThemeManager.
    -->

    <style name="ThemeOverlay.Launch.Palette.Nord" parent="">
        <item name="appAccent">@color/nord8</item>
        <item name="appAccentMuted">@color/nord9</item>
        <item name="appAccentSecondary">@color/nord10</item>
        <item name="appOnAccent">#2E3440</item>
        <item name="appHighlight">@color/nord7</item>

        <item name="appBackground">@color/background</item>
        <item name="appSurface">@color/card_background</item>
        <item name="appSurfaceVariant">@color/widget_item_background</item>
        <item name="appSurfaceElevated">@color/dialog_background</item>
        <item name="appScrim">@color/black</item>

        <item name="appTextPrimary">@color/white</item>
        <item name="appTextSecondary">@color/text_secondary</item>
        <item name="appTextTertiary">@color/text_tertiary</item>
        <item name="appTextHint">@color/text_hint</item>
        <item name="appIconTint">@color/icon_color</item>
        <item name="appTextShadow">#BF000000</item>

        <item name="appOutline">@color/outlineColor</item>
        <item name="appOutlineMuted">@color/nord3</item>
        <item name="appDivider">#0DFFFFFF</item>
        <item name="appRippleColor">@color/dialog_button_background</item>
        <item name="appSurfaceBorder">@color/widget_divider</item>

        <item name="appError">@color/nord11</item>
        <item name="appSuccess">@color/nord14</item>
        <item name="appWarning">@color/nord13</item>

        <item name="appChart1">@color/nord7</item>
        <item name="appChart2">@color/nord8</item>
        <item name="appChart3">@color/nord9</item>
        <item name="appChart4">@color/nord14</item>

        <item name="appIsLight">false</item>
    </style>

    <style name="ThemeOverlay.Launch.Palette.Nord.Opaque" parent="">
        <item name="appSurface">#FF191C24</item>
        <item name="appSurfaceVariant">#FF232733</item>
        <item name="appSurfaceElevated">#FF191C24</item>
    </style>

