<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibrate_your_stride_length_for_more_accurate_d"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:alpha="0.8"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/height_cm"
            style="@style/DialogFieldLabel"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/height_input"
            style="@style/DialogEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/height_input"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stride_length_meters"
            style="@style/DialogFieldLabel"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/stride_length_input"
            style="@style/DialogEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/stride_length_input"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/current_stride_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_stride_length_0_75_m"
            android:textColor="@color/nord8"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/reset_calibration_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_neutral_ripple"
            android:text="@string/reset_to_default"
            android:textColor="@color/text"
            android:textAllCaps="false"
            android:paddingVertical="12dp" />

    </LinearLayout>
</ScrollView>
