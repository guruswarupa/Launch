<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/background"/>

    <View
        android:id="@+id/settings_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"/>

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system_monitor_title"
                android:textSize="32sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:letterSpacing="-0.01"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/real_time_system_performance_and_hardware_info"
                android:textColor="@color/white"
                android:alpha="0.5"
                android:textSize="14sp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CPU Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cpu_performance"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/nord8"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outlineColor">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/cpu_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cpu_loading"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/cpu_temp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cpu_temp_c"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>

                        <com.guruswarupa.launch.ui.views.UsageGraphView
                            android:id="@+id/cpu_graph"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/individual_cores"
                            android:textSize="11sp"
                            android:textColor="@color/white"
                            android:alpha="0.5"
                            android:layout_marginTop="16dp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"/>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cpu_cores_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:chipSpacingVertical="4dp"
                            app:chipSpacingHorizontal="4dp">
                            <!-- Core chips added dynamically -->
                        </com.google.android.material.chip.ChipGroup>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GPU Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gpu_performance"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/nord8"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outlineColor">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/gpu_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gpu_loading"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/gpu_temp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gpu_temp_c"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>

                        <com.guruswarupa.launch.ui.views.UsageGraphView
                            android:id="@+id/gpu_graph"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="12dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/gpu_cores_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingVertical="4dp"
                            app:chipSpacingHorizontal="4dp">
                            <!-- GPU details added dynamically -->
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Hardware Info Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hardware_category"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/nord8"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outlineColor">

                    <LinearLayout
                        android:id="@+id/hardware_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Battery Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_category"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/nord8"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outlineColor">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/battery_health"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/health_loading"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/battery_capacity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/capacity_loading"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/battery_calculated_health"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/calculated_health"
                            android:textColor="@color/nord8"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:id="@+id/battery_voltage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/voltage"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:id="@+id/battery_temp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/temperature"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/battery_charging_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/charging_speed"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/battery_time_remaining"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/time_remaining"
                            android:textColor="@color/white"
                            android:alpha="0.7"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Network Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/network_category"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/nord8"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outlineColor">

                    <LinearLayout
                        android:id="@+id/network_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Camera & Sensors Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_sensors_category"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/nord8"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/outlineColor">

                    <LinearLayout
                        android:id="@+id/sensors_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
