<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/battery_health_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/battery_health"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/battery_level"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/battery_percentage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textColor="@color/nord14"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_remaining_2"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"/>
                
                <TextView
                    android:id="@+id/time_remaining_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5h 30m"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/charging_speed_2"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"/>
                
                <TextView
                    android:id="@+id/charging_speed_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1200 mA"
                    android:textColor="@color/nord10"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voltage_2"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"/>
                
                <TextView
                    android:id="@+id/voltage_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4200 mV"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/temperature_2"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"/>
                
                <TextView
                    android:id="@+id/temperature_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30°C"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/design_capacity"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/design_capacity_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4000 mAh"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_charge"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/live_capacity_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- mAh"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/full_capacity"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/current_full_capacity_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3800 mAh"
                    android:textColor="@color/widget_text"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/calculated_health_2"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/health_prediction_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/predicted"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/calculated_health_percentage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/nord8"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/health_status"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/health_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/good"
                android:textColor="@color/nord14"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
