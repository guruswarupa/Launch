<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Habit Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/habit_name"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/habit_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/e_g_exercise_read_meditate"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary" />

        <!-- Description (Optional) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description_optional_2"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/habit_description_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/brief_description_of_your_habit"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary" />

        <!-- Frequency -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frequency"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/habit_frequency_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp" />

        <!-- Custom Days Selection -->
        <LinearLayout
            android:id="@+id/custom_days_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_days"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/habit_day_sunday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sunday"
                    android:textColor="@color/text" />

                <CheckBox
                    android:id="@+id/habit_day_monday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monday"
                    android:textColor="@color/text" />

                <CheckBox
                    android:id="@+id/habit_day_tuesday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tuesday"
                    android:textColor="@color/text" />

                <CheckBox
                    android:id="@+id/habit_day_wednesday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wednesday"
                    android:textColor="@color/text" />

                <CheckBox
                    android:id="@+id/habit_day_thursday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/thursday"
                    android:textColor="@color/text" />

                <CheckBox
                    android:id="@+id/habit_day_friday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/friday"
                    android:textColor="@color/text" />

                <CheckBox
                    android:id="@+id/habit_day_saturday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saturday"
                    android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Reminder Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_reminder"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/habit_enable_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_reminder_time"
            android:textColor="@color/text" />

        <TimePicker
            android:id="@+id/habit_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
