<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/background"/>

    <View
        android:id="@+id/theme_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"/>

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_workspace_active_icon"
                app:tint="?attr/appAccent"
                android:contentDescription="@string/workspaces"/>

            <TextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/appTextPrimary"/>
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/a11y_workspace_name"
            android:textSize="14sp"
            android:textColor="?attr/appTextSecondary"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stock_drawer_search_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/workspace_name_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/a11y_workspace_name"
                android:textColor="?attr/appTextPrimary"
                android:textColorHint="?attr/appTextHint"
                android:padding="14dp"
                android:background="@null"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_workspace_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel_button"
                android:textAllCaps="false"
                android:background="@drawable/settings_card_background"
                android:textColor="?attr/appTextPrimary"
                android:padding="16dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/save_workspace_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_button"
                android:textAllCaps="false"
                android:background="@drawable/focus_mode_save_button_bg"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium"
                android:padding="16dp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
