<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    
    <ImageView
        android:id="@+id/disclosure_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:color/black" />

    
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    
    <LinearLayout
        android:id="@+id/welcome_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:text="@string/welcome"
            android:textColor="@color/white"
            android:textSize="72sp"
            android:alpha="0"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/welcome_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.25"
            android:text="@string/to_launch"
            android:textColor="@color/nord8"
            android:textSize="13sp"
            android:alpha="0"
            android:textAllCaps="true" />
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/disclosure_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.15" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="20dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:contentDescription="@string/app_name"
                    android:alpha="0.95" />

                <TextView
                    android:id="@+id/disclosure_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_data_disclosure_title"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="32dp"
                    android:alpha="0.95" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/widget_background"
                    android:padding="28dp"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:id="@+id/disclosure_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_data_disclosure_message"
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-light"
                        android:lineSpacingExtra="8dp"
                        android:alpha="0.9" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resources"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/nord8"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.7" />

                    <TextView
                        android:id="@+id/disclosure_links"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/data_disclosure_links"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:alpha="0.75"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/decline_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="@string/decline"
                android:background="@drawable/button_black_translucent_ripple"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:alpha="0.7"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/accept_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/i_agree"
                android:background="@drawable/button_black_translucent_ripple"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:textAllCaps="true"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:alpha="0.95"
                android:letterSpacing="0.1" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/feature_onboarding_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/feature_onboarding_step_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/discover_launch"
                android:textColor="@color/nord8"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.18" />

            <Button
                android:id="@+id/feature_onboarding_skip_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="@string/usage_stats_permission_skip"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2" />

        <LinearLayout
            android:id="@+id/feature_onboarding_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/feature_visual_card"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/widget_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/feature_icon_chip_start"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/circular_background"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/feature_icon_start"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            app:tint="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/feature_icon_chip_center"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/circular_background"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/feature_icon_center"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            app:tint="@color/white" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/feature_icon_chip_end"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/circular_background"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/feature_icon_end"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            app:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/feature_visual_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/search_focus_make_the_launcher_work_for_you"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/feature_onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/everything_important_is_right_on_the_home_screen"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:fontFamily="sans-serif-thin"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/feature_onboarding_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/launch_helps_you_search_faster_manage_apps_bette"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:alpha="0.9"
                android:fontFamily="sans-serif-light"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:id="@+id/feature_onboarding_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/you_can_still_customize_everything_later"
                android:textColor="@color/nord8"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/feature_page_indicators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/feature_onboarding_back_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/back_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/button_black_translucent_ripple"
                app:backgroundTint="@null"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/feature_onboarding_next_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/app_lock_action_continue"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/button_black_translucent_ripple"
                app:backgroundTint="@null"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/import_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2" />

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="28dp"
            android:src="@drawable/ic_archive"
            app:tint="@color/nord8"
            android:alpha="0.9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_data"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/white"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:layout_marginBottom="16dp"
            android:alpha="0.95" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restore_your_previous_configuration_from_a_backu"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:alpha="0.75"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="48dp"
            android:paddingHorizontal="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/import_data_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/choose_backup_file"
                android:background="@drawable/button_black_translucent_ripple"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"
                android:alpha="0.95"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/skip_import_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/start_fresh"
                android:background="@drawable/button_black_translucent_ripple"
                app:backgroundTint="@null"
                android:textColor="@color/white"
                android:alpha="0.6"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3" />

    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/view_mode_selection_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="gone">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_view_mode"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/white"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:layout_marginBottom="12dp"
            android:alpha="0.95" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_how_you_want_your_apps_to_be_displayed"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:alpha="0.7"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="40dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/list_mode_option"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical"
                android:background="@drawable/selectable_card_background"
                android:padding="24dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="8dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/preview_item_background_accent"
                        android:alpha="0.8" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="8dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/preview_item_background"
                        android:alpha="0.4" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="8dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/preview_item_background"
                        android:alpha="0.4" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="8dp"
                        android:background="@drawable/preview_item_background"
                        android:alpha="0.4" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/calendar_view_list"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.95" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vertical_list"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:alpha="0.6"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/grid_mode_option"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:background="@drawable/selectable_card_background"
                android:padding="24dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="4dp">

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/preview_item_background_accent"
                            android:alpha="0.8" />

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/preview_item_background"
                            android:alpha="0.4" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/preview_item_background"
                            android:alpha="0.4" />

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/preview_item_background"
                            android:alpha="0.4" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grid"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.95" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grid_layout"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:alpha="0.6"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_can_change_this_later_in_settings"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/white"
            android:gravity="center"
            android:alpha="0.5"
            android:layout_marginBottom="16dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2" />

    </LinearLayout>
</FrameLayout>
