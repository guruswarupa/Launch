<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        
        <EditText
            android:id="@+id/task_input"
            style="@style/DialogEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_todo_item"
            android:layout_marginBottom="16dp" />

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category"
            android:textColor="?attr/appTextPrimary"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/category_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/priority"
            android:textColor="?attr/appTextPrimary"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/priority_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/due_time_optional"
            android:textColor="?attr/appTextPrimary"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/enable_time_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_due_time"
            android:textColor="?attr/appTextPrimary"
            android:buttonTint="?attr/appIconTint"
            android:layout_marginBottom="8dp" />

        <TimePicker
            android:id="@+id/time_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        
        <CheckBox
            android:id="@+id/recurring_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recurring_task"
            android:textColor="?attr/appTextPrimary"
            android:buttonTint="?attr/appIconTint"
            android:layout_marginBottom="8dp" />

        
        <RadioGroup
            android:id="@+id/recurrence_type_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/recurrence_days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/days"
                android:textColor="?attr/appTextPrimary"
                android:buttonTint="?attr/appIconTint"
                android:checked="true" />

            <RadioButton
                android:id="@+id/recurrence_interval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/interval"
                android:textColor="?attr/appTextPrimary"
                android:buttonTint="?attr/appIconTint" />

        </RadioGroup>

        
        <LinearLayout
            android:id="@+id/interval_selection_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every"
                android:textColor="?attr/appTextPrimary"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/interval_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_time"
                android:textColor="?attr/appTextPrimary"
                android:layout_marginBottom="8dp" />

            <TimePicker
                android:id="@+id/interval_start_time_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner" />

        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/days_selection_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_days"
                android:textColor="?attr/appTextPrimary"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:alignmentMode="alignBounds"
                android:useDefaultMargins="false">

                <CheckBox
                    android:id="@+id/checkbox_sunday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:text="@string/sun"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="11sp"
                    android:buttonTint="?attr/appIconTint"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <CheckBox
                    android:id="@+id/checkbox_monday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:text="@string/mon"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="11sp"
                    android:buttonTint="?attr/appIconTint"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <CheckBox
                    android:id="@+id/checkbox_tuesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:text="@string/tue"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="11sp"
                    android:buttonTint="?attr/appIconTint"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <CheckBox
                    android:id="@+id/checkbox_wednesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:text="@string/wed"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="11sp"
                    android:buttonTint="?attr/appIconTint"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <CheckBox
                    android:id="@+id/checkbox_thursday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:text="@string/thu"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="11sp"
                    android:buttonTint="?attr/appIconTint"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <CheckBox
                    android:id="@+id/checkbox_friday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:text="@string/fri"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="11sp"
                    android:buttonTint="?attr/appIconTint"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <CheckBox
                    android:id="@+id/checkbox_saturday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:text="@string/sat"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="11sp"
                    android:buttonTint="?attr/appIconTint"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

            </GridLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
