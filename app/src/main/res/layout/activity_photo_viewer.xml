<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.guruswarupa.launch.ui.views.ZoomImageView
        android:id="@+id/photo_zoom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null" />

    <ProgressBar
        android:id="@+id/photo_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFF" />

    <TextView
        android:id="@+id/photo_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/photo_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/media_gradient_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/photo_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button"
            android:padding="12dp"
            android:src="@drawable/ic_media_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/photo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/photo_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/photo_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/media_gradient_bottom"
        android:orientation="horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/photo_action_share"
            style="@style/MediaAction">
            <ImageView style="@style/MediaActionIcon" android:src="@drawable/ic_media_share" android:contentDescription="@null" />
            <TextView style="@style/MediaActionLabel" android:text="@string/media_action_share" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/photo_action_rotate"
            style="@style/MediaAction">
            <ImageView style="@style/MediaActionIcon" android:src="@drawable/ic_f_rename" android:contentDescription="@null" />
            <TextView style="@style/MediaActionLabel" android:text="@string/media_action_edit" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/photo_action_info"
            style="@style/MediaAction">
            <ImageView style="@style/MediaActionIcon" android:src="@drawable/ic_media_info" android:contentDescription="@null" />
            <TextView style="@style/MediaActionLabel" android:text="@string/media_action_details" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/photo_action_open"
            style="@style/MediaAction">
            <ImageView style="@style/MediaActionIcon" android:src="@drawable/ic_media_more" android:contentDescription="@null" />
            <TextView style="@style/MediaActionLabel" android:text="@string/media_action_more" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
