<?xml version="1.0" encoding="utf-8"?>
<!-- Tap the mini lyrics widget to open this: the complete lyrics, fullscreen and scrollable, with
     an opaque background (not a floating card over a dimmed home screen). Synced lyrics render as
     one row per line with the current line highlighted and auto-scrolled into view, each line
     tappable to seek there; plain (unsynced) lyrics just render as one readable paragraph with no
     per-line click handling, since there's no timestamp to seek to. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appBackground"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/full_lyrics_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_right"
            android:rotation="90"
            app:tint="?attr/appTextSecondary"
            android:contentDescription="@string/close_button"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="48dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/full_lyrics_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/full_lyrics_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/full_lyrics_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/full_lyrics_lines_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"/>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
